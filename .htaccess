# Prevent Directory Indexing and redirect /fa/ to root /
Options -Indexes

RewriteEngine On
RewriteBase /

# 1. API routing to PHP backend
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# 2. Redirect /fa/ or /fa to /
RewriteRule ^fa/?$ / [R=301,L]

# 3. Redirect english/other language roots
RewriteRule ^en/?$ / [R=301,L]
RewriteRule ^ko/?$ / [R=301,L]
RewriteRule ^ja/?$ / [R=301,L]
RewriteRule ^zh/?$ / [R=301,L]

# 4. Redirect aliases without /fa/ prefix to /fa/...
RewriteRule ^about/?$ /fa/about/ [R=301,L]
RewriteRule ^c/?$ /fa/c/ [R=301,L]
RewriteRule ^story/?$ /fa/story/ [R=301,L]
RewriteRule ^edu/?$ /fa/edu/ [R=301,L]
RewriteRule ^privacy/?$ /fa/privacy/ [R=301,L]
RewriteRule ^terms/?$ /fa/terms/ [R=301,L]
RewriteRule ^help/?$ /fa/help/ [R=301,L]
RewriteRule ^c/(.*)$ /fa/c/$1 [R=301,L]
RewriteRule ^story/(.*)$ /fa/story/$1 [R=301,L]

# 5. Serve physical files/directories if they exist
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 6. Fallback for SPA routing to main index.html
RewriteRule ^ /index.html [L]
